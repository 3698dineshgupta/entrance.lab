generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  password         String
  name             String?
  role             Role              @default(USER)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  attempts         Attempt[]
  practiceAttempts PracticeAttempt[]
  materialRequests MaterialRequest[]
}

enum Role {
  USER
  ADMIN
}

// A user-submitted request for study material that isn't on the site yet
// (e.g. "add IOE English past papers"), surfaced to admins for follow-up.
// userId is optional since the Request Hub form doesn't require login.
model MaterialRequest {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  whatsapp  String
  message   String
  status    String   @default("pending") // "pending" | "fulfilled"
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

model TestSet {
  id              String   @id @default(cuid())
  exam            String // e.g., "IOE" or "CEE"
  title           String
  mode            String // "full" or "subject"
  subject         String?
  difficulty      String   @default("mixed")
  durationMinutes Int
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  questions Question[]
  attempts  Attempt[]
}

model Question {
  id            String   @id @default(cuid())
  testId        String
  subject       String
  topic         String?
  subtopic      String?
  text          String
  options       String[] // PostgreSQL string array
  correctIndex  Int
  explanation   String?
  difficulty    String   @default("medium")
  marks         Int      @default(1)
  negativeMarks Float?   @default(0)

  testSet          TestSet           @relation(fields: [testId], references: [id], onDelete: Cascade)
  practiceAttempts PracticeAttempt[]
}

// One row per (user, question) — tracks the user's most recent practice-mode
// answer so the subtopic browser can show completion progress and resume
// sessions at the first unanswered question. Upserted on every answer, not
// a full attempt history.
model PracticeAttempt {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  correct    Boolean
  answeredAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
}

model Attempt {
  id              String   @id @default(cuid())
  userId          String
  testId          String
  startedAt       DateTime
  submittedAt     DateTime
  durationSeconds Int
  answers         Json // Store { "questionId": index }
  marked          Json // Store { "questionId": boolean }
  subjectTimes    Json? // Store { "subject": seconds }

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  testSet TestSet @relation(fields: [testId], references: [id], onDelete: Cascade)
}
